# EVOL-1's renders: the simulator's screens and lights (tools/site/mockups.py runs this). 'echo @name' then
# 'leds' names the lights that go with a shot.
splash 3200
reboot
wait 900
shot splash.png
wait 1500
shot splash_evol.png
wait 1200
# into the song: past the intro, everything playing
wait 24000
tap HOME
spin ALGO 2
spin SELECT 4
wait 600
shot pattern.png
echo @pattern
leds
tap SEQ
wait 600
shot song.png
echo @song
leds
tap ENV
wait 600
shot sound.png
echo @sound
leds
tap ENV
wait 600
shot move.png
echo @move
leds
tap ENV
wait 600
shot sends.png
echo @sends
leds
tap LFO
wait 600
shot space.png
echo @space
leds
tap LFO
wait 600
shot groove.png
echo @groove
leds
tap ARP
spin ALGO 2
wait 600
shot grow.png
echo @grow
leds
tap GLO
wait 600
shot setup.png
echo @setup
leds
tap GLO
wait 600
shot device.png
echo @device
leds
tap HOME
wait 300
press FX
wait 600
tapkey b1
wait 300
shot mutes.png
echo @mutes
leds
tapkey b1
release FX
wait 300
press REC
wait 1100
shot help.png
release REC
wait 300
# writing: REC on, the cursor on track 4, a phrygian figure going in
tap PLAY
wait 300
tap REC
spin ALGO 1
spin SELECT -8
tapkey 9
tapkey 10
spin SELECT 1
tapkey 9
spin K2 1
spin K3 4
wait 600
shot rec.png
echo @rec
leds
tap REC
tap PLAY
wait 6000
shot playing.png
echo @playing
leds
wait 200
shot s_deep.png
# changes unsaved (the REC above): the first turn warns, the second opens the next song (playing on from its top)
spin PRESET 1
spin PRESET 1
wait 30000
shot s_weather.png
spin PRESET 1
wait 30000
shot s_ritual.png
spin PRESET 1
wait 30000
shot s_garden.png
spin PRESET 1
wait 30000
shot s_bugs.png
spin PRESET 1
wait 25000
wait 600
shot t_evol.png
tap GLO
tap GLO
spin K1 1
tap HOME
wait 600
shot t_static.png
tap GLO
tap GLO
spin K1 1
tap HOME
wait 600
shot t_bruise.png
tap GLO
tap GLO
spin K1 1
tap HOME
wait 600
shot t_ember.png
tap GLO
tap GLO
spin K1 1
tap HOME
wait 600
shot t_mono.png
tap GLO
tap GLO
spin K1 -4
tap HOME
