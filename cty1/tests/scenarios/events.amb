# CTY-1 (set 1 N: the tests grow a new city to stage N straight; set 46 B+1 picks its biome): every incident called from the black keys, the biomes' own disasters, the weather and the hour, the camera follows
set 1 2
tap EDIT
wait 6000
expect stage >1
tap FX
expect hall 3
tapkey b0
wait 1500
expect trucks >0
shot ev_bolt.png
tapkey b1
wait 600
expect quake 1
shot ev_quake.png
wait 9000
tapkey b2
wait 200
expect robbery 1
wait 2500
shot ev_robbery.png
wait 4000
expect robphase >0
expect cops >0
tapkey b3
wait 200
expect crash 1
wait 1000
expect ambulances >0
wait 2500
shot ev_crash.png
tapkey b4
wait 200
expect ufo 1
wait 5000
shot ev_ufo.png
tapkey b5
wait 3000
tapkey b6
wait 300
expect region 1
wait 3000
shot ev_region.png
tapkey b7
wait 200
expect festival 1
tapkey b8
expect blackout 1
tapkey b9
expect meteors 1
wait 4000
shot ev_festival.png
wait 40000
expect region 0
expect festival 0
expect blackout 0
tap EDIT
wait 5000
tapkey b6
wait 6000
expect region 1
shot ev_region2.png
spin PRESET 1
wait 5000
tapkey b6
wait 6000
expect region 1
shot ev_region3.png
tap LFO
tapkey b3
wait 500
expect hour >21
tapkey b1
wait 500
expect hour 12
tap LFO
tapkey b4
wait 8000
expect weather 3
shot ev_storm.png
tapkey b6
wait 8000
expect weather 5
shot ev_snow.png
expect notes >100
expect peak_db_max -0.5
# a desert grown huge: its specials, the rocket on its pad, the launch
wait 10
tap HOME
set 46 2
set 1 3
tap EDIT
wait 6000
expect biome 1
expect unlocked 3
expect hall 4
tap FX
tapkey b10
wait 200
expect show 1
wait 9000
shot ev_launch.png
wait 9000
expect show 0
# its specials keep their own clocks: the solar farm's and the resort's moments, the launch on the hour's
wait 100000
expect moments >2
# the docks on the water, the boats on it (isles, a city)
tap HOME
set 46 4
set 1 2
tap EDIT
wait 30000
expect biome 3
expect docks >0
expect boats >0
shot ev_boats.png
