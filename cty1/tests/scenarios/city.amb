# CTY-1: a new city each power-on, in a biome; it grows, the music plays, the pages walk; PRESETS the biomes,
# EDIT a new city, SAVE keeps the settings, held the biome's music back
wait 2000
expect playing 1
expect stage 0
expect week >0
shot city_town.png
spin K1 3
expect par0 5
wait 70000
expect stage >0
expect cars >0
expect peds >0
shot city_suburb.png
tap HOME
expect notes >200
expect hits >10
spin SELECT 1
expect view 1
spin SELECT 12
expect view 12
spin SELECT -12
expect view 0
tap LFO
expect view 3
tap LFO
expect view 4
tap FX
expect view 7
tap FX
expect view 8
tap FX
expect view 9
tap GLO
expect view 10
tap GLO
expect view 11
tap GLO
expect view 12
tap HOME
tap PLAY
expect playing 0
tap PLAY
expect playing 1
tap REC
expect hold 1
tap REC
expect hold 0
# a new city on every turn of PRESETS (or EDIT), each in its biome with its music; the host can ask for a biome
# (set 46 B+1: there's no knob for it, the biome is the luck of the draw)
expect biome 6
set 46 1
spin PRESET 1
expect biome 0
expect stage 0
expect par4 96
set 46 4
tap EDIT
wait 200
expect biome 3
expect stage 0
expect par4 112
set 46 2
spin PRESET -1
expect biome 1
expect par4 88
set 46 0
tap GLO
tap SAVE
expect store_writes 1
expect dirty 0
# a power-on: a new city, always a town, in a biome of its own
entropy 777
reboot
wait 3000
expect stage 0
expect par46 0
shot city_newtown.png
tap HOME
spin K4 3
press SAVE
wait 1700
release SAVE
expect biome 5
expect par4 120
